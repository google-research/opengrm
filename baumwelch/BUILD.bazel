# Bazel build file.

package(default_visibility = ["//visibility:public"])

licenses(["notice"])

prefix_dir = "src/"

cc_library(
    name = "baumwelch",
    hdrs = [
        prefix_dir + "include/baumwelch/a-star.h",
        prefix_dir + "include/baumwelch/baumwelch.h",
        prefix_dir + "include/baumwelch/cascade.h",
        prefix_dir + "include/baumwelch/decode.h",
        prefix_dir + "include/baumwelch/expectation-table.h",
        prefix_dir + "include/baumwelch/log-adder.h",
        prefix_dir + "include/baumwelch/randomize.h",
        prefix_dir + "include/baumwelch/train.h",
        prefix_dir + "include/baumwelch/util.h",
    ],
    includes = [prefix_dir + "include"],
    deps = [
        "@org_openfst//:far_base",
        "@org_openfst//:fst",
    ],
)

OPERATIONS = [
    "decode",
    "randomize",
    "train",
]

[
    cc_library(
        name = "script_%s" % operation,
        srcs = [prefix_dir + "script/%sscript.cc" % operation],
        hdrs = [prefix_dir + "include/baumwelch/%sscript.h" % operation],
        deps = [
            ":baumwelch",
            "@org_openfst//:fstscript_base",
        ],
    )
    for operation in OPERATIONS
]

[
    cc_binary(
        name = operation,
        srcs = [
            prefix_dir + "bin/baumwelch%s-main.cc" % operation,
            prefix_dir + "bin/baumwelch%s.cc" % operation,
        ],
        linkstatic = True,
        deps = [
            ":script_%s" % operation,
            "@org_openfst//:farscript",
        ],
    )
    for operation in OPERATIONS
]
