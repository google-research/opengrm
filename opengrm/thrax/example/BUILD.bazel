# Sample grammar for demonstrating some of the functionality of the grammar
# compiler. This is identical to the sample grammar that is published along
# with the open-source version Thrax.

load("//opengrm/thrax:grm_build_defs.bzl", "compile_grm")

package(default_visibility = ["//visibility:public"])

compile_grm(
    name = "example",
    data = [
        ":ernest.txt",
    ],
    deps = [
        ":numbers",
        "//opengrm/thrax/stdlib:byte",
    ],
)

compile_grm(
    name = "numbers",
    deps = [
        "//opengrm/thrax/stdlib:byte",
    ],
)
