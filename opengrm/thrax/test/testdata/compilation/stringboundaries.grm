## Test the beginning/end-of-string delimiters work

sigma = ("a" | "b" | "c" | "d")*;

## Delete "a" at the beginning of a string

export beg = CDRewrite["a" : "", "[BOS]", "", sigma];

## Delete "a" at the end of a string

export end = CDRewrite["a" : "", "", "[EOS]", sigma];

## Insert an "a" anywhere. Prior to CL 88076596 this would fail because it
## would insert "a" before the "[BOS]" and after the "[EOS]", which would then
## fail due to the output filter "[BOS] sigma_star [EOS]"

export ins_a = CDRewrite["" : "a", "", "", sigma];
