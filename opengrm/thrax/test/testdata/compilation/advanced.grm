import 'opengrm/thrax/test/testdata/compilation/basic.grm' as basic;

func UnionWithTriple[fst] {
  fst3 = fst fst fst;
  result = fst | fst3;
  return result;
}

export one_or_three = basic.Clean[UnionWithTriple[basic.kLower]];

cap_single_vowel = basic.kLower |
    ("a" : "A" <-1>) | ("e" : "E" <-1>) | ("i" : "I" <-1>) | ("o" : "O" <-1>) |
    ("u" : "U" <-1>) | ("y" : "Y" <-1>);
export cap_all_vowels = RmEpsilon[cap_single_vowel*];
