import 'opengrm/thrax/test/testdata/compilation/basic.grm' as bas;
import 'opengrm/thrax/test/testdata/compilation/advanced.grm' as adv;

# Here, we'll try using secondary imports (i.e., a symbol that's included by an
# included file).
export test1 = bas.Clean[adv.UnionWithTriple[bas.kUpper]];
export test2 = bas.Clean[adv.UnionWithTriple[adv.basic.kUpper]];
export test3 = adv.basic.Clean[adv.UnionWithTriple[bas.kUpper]];
export test4 = adv.basic.Clean[adv.UnionWithTriple[adv.basic.kUpper]];
