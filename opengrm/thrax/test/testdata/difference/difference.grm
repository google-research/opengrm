maj_mappings =
  StringFile['opengrm/thrax/test/testdata/difference/money_maj_nouns.tsv'];

export first = Optimize[Project[maj_mappings, 'input']];

adj_maj_units1 =
 LoadFst['opengrm/thrax/test/testdata/difference/adj_maj_mapping_adjfirst.fst']
;

export second = Optimize[Project[adj_maj_units1, 'input']];

export NO_ADJ_UNITS = Optimize[first - second];
