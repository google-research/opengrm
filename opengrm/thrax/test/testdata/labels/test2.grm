# Importing t1 will also bring in the labels for [aaa] and [bbb].
import 'opengrm/thrax/test/testdata/labels/test1.grm' as t1;

# [aaa] = 1048576 (loaded from test1.grm)
# [bbb] = 1048577 (loaded from test1.grm)
# [ccc] = 1048578 (the "new" one despite appearing fist)
C_to_c = "C" : "[ccc]";
c_to_a = "[ccc]" : "[aaa]";
b_to_B = "[bbb]" : "B";

# So this should rewrite capital C to capital B.  If the labels don't match up,
# we'll get an empty FST (and no match).
export C_to_B = Optimize[C_to_c @ c_to_a @ t1.a_to_b @ b_to_B];
