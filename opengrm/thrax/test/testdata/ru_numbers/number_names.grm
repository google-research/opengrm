# RUSSIAN NUMBER NAMES.
#
################################################################################

# We adopt the following naming conventions:

# Target CARDINAL_NUMBER_NAME is the *counting form*

# Target CARDINAL_NUMBER_NAME_INFLECTED is the *inflected form*

# Target ORDINAL_NUMBER_NAME is the ordinal number name, with inflectional
# endings: if a language inflects ordinals, then one has to pick some inflected
# ending.

# Russian details:

# This grammar allows thousands factorings using periods or spaces. It does not
# deal with decimal numbers, but it provides hooks for constructing those.

# Russian number name inflection is extremely complicated. Number names are in
# general inflected for up to six cases, three genders and two
# numbers. "Thousand", "million", "billion" and so forth are nouns, when these
# are modified before them ("fifty two thousand", "nine million") they occur in
# various cases depending upon the case of the modifier. See below.
#
# As with German we model the inflectional environments by having strings --
# e.g. __MAS,GEN after the number. We assume that this information will be
# available from some other source in order to tell which form you want in a
# given context.
#
# See below on ordinal numbers
#
# Grammar is based on:
#
# Wade, Terence. 1992. A Comprehensive Russian Grammar. Oxford, Blackwell.

################################################################################

import 'opengrm/thrax/stdlib/byte.grm' as bytelib;
import 'opengrm/thrax/test/testdata/ru_numbers/thousands_punct.grm' as tp;
import 'opengrm/thrax/test/testdata/ru_numbers/util.grm' as util;
import 'opengrm/thrax/test/testdata/ru_numbers/western_factorization.grm' as wf;

################################################################################

##
ins_space = "" : " " ;
pass_space = " " ;
pass_space_star = pass_space*;

## Basic cardinal number vocabulary.

cardinal_vocabulary = Optimize[
    ("0" : "нуль")
  | ("0" : "нуля")
  | ("0" : "нулю")
  | ("0" : "нулем")
  | ("0" : "нуле")
## I(f some of these forms for zero are preferred we can switch around the weights.)
  | ("0" : "ноль" <1.0>)
  | ("0" : "ноля" <1.0>)
  | ("0" : "нолю" <1.0>)
  | ("0" : "нолем" <1.0>)
  | ("0" : "ноле" <1.0>)
  | ("1" : "один")
  | ("1" : "одного")
  | ("1" : "одному")
  | ("1" : "одним")
  | ("1" : "одном")
  | ("1" : "одна")
  | ("1" : "одну")
  | ("1" : "одной")
  | ("1" : "одною")
  | ("1" : "одно")
  | ("1" : "одни")
  | ("1" : "одних")
  | ("1" : "одними")
  | ("2" : "два")
  | ("2" : "две")
  | ("2" : "двух")
  | ("2" : "двум")
  | ("2" : "двумя")
  | ("3" : "три")
  | ("3" : "трех")
  | ("3" : "трем")
  | ("3" : "тремя")
  | ("4" : "четыре")
  | ("4" : "четырех")
  | ("4" : "четырем")
  | ("4" : "четырьмя")
  | ("5" : "пять")
  | ("5" : "пяти")
  | ("5" : "пятью")
  | ("6" : "шесть")
  | ("6" : "шести")
  | ("6" : "шестью")
  | ("7" : "семь")
  | ("7" : "семи")
  | ("7" : "семью")
  | ("8" : "восемь")
  | ("8" : "восьми")
  | ("8" : "восьмью")
  | ("9" : "девять")
  | ("9" : "девяти")
  | ("9" : "девятью")
  | (("1[E1]") : "десять")
  | (("1[E1]") : "десяти")
  | (("1[E1]") : "десятью")
  | (("1[E1]1") : "одиннадцать" <-1>)
  | (("1[E1]1") : "одиннадцати" <-1>)
  | (("1[E1]1") : "одиннадцатью" <-1>)
  | (("1[E1]2") : "двенадцать" <-1>)
  | (("1[E1]2") : "двенадцати" <-1>)
  | (("1[E1]2") : "двенадцатью" <-1>)
  | (("1[E1]3") : "тринадцать" <-1>)
  | (("1[E1]3") : "тринадцати" <-1>)
  | (("1[E1]3") : "тринадцатью" <-1>)
  | (("1[E1]4") : "четырнадцать" <-1>)
  | (("1[E1]4") : "четырнадцати" <-1>)
  | (("1[E1]4") : "четырнадцатью" <-1>)
  | (("1[E1]5") : "пятнадцать" <-1>)
  | (("1[E1]5") : "пятнадцати" <-1>)
  | (("1[E1]5") : "пятнадцатью" <-1>)
  | (("1[E1]6") : "шестнадцать" <-1>)
  | (("1[E1]6") : "шестнадцати" <-1>)
  | (("1[E1]6") : "шестнадцатью" <-1>)
  | (("1[E1]7") : "семнадцать" <-1>)
  | (("1[E1]7") : "семнадцати" <-1>)
  | (("1[E1]7") : "семнадцатью" <-1>)
  | (("1[E1]8") : "восемнадцать" <-1>)
  | (("1[E1]8") : "восемнадцати" <-1>)
  | (("1[E1]8") : "восемнадцатью" <-1>)
  | (("1[E1]9") : "девятнадцать" <-1>)
  | (("1[E1]9") : "девятнадцати" <-1>)
  | (("1[E1]9") : "девятнадцатью" <-1>)
  | (("2[E1]") : "двадцати")
  | (("2[E1]") : "двадцать")
  | (("2[E1]") : "двадцатью")
  | (("3[E1]") : "тридцати")
  | (("3[E1]") : "тридцать")
  | (("3[E1]") : "тридцатью")
  | (("4[E1]") : "сорок")
  | (("4[E1]") : "сорока")
  | (("5[E1]") : "пятидесяти")
  | (("5[E1]") : "пятьдесять")
  | (("5[E1]") : "пятьюдесятью")
  | (("6[E1]") : "шестидесяти")
  | (("6[E1]") : "шестьдесять")
  | (("6[E1]") : "шестьюдесятью")
  | (("7[E1]") : "семидесяти")
  | (("7[E1]") : "семьдесять")
  | (("7[E1]") : "семьюдесятью")
  | (("8[E1]") : "восьмидесяти")
  | (("8[E1]") : "восемьдесять")
  | (("8[E1]") : "восьмьюдесятью")
  | (("9[E1]") : "девяноста")
