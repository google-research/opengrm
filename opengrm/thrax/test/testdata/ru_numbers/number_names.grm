  | (("1[E2]") : "сто")
  | (("1[E2]") : "ста")
  | (("2[E2]") : "двести")
  | (("2[E2]") : "двумстам")
  | (("2[E2]") : "двумястами")
  | (("2[E2]") : "двухсот")
  | (("2[E2]") : "двухстах")
  | (("3[E2]") : "тремстам")
  | (("3[E2]") : "тремястами")
  | (("3[E2]") : "трехсот")
  | (("3[E2]") : "трехстах")
  | (("3[E2]") : "триста")
  | (("4[E2]") : "четыремстам")
  | (("4[E2]") : "четыреста")
  | (("4[E2]") : "четырехсот")
  | (("4[E2]") : "четырехстах")
  | (("4[E2]") : "четырьмястами")
  | (("5[E2]") : "пятисот")
  | (("5[E2]") : "пятистам")
  | (("5[E2]") : "пятистах")
  | (("5[E2]") : "пятьсот")
  | (("5[E2]") : "пятьюстами")
  | (("6[E2]") : "шестисот")
