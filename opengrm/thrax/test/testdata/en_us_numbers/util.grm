# Utility functions.

import 'opengrm/thrax/stdlib/byte.grm' as bytelib;

# A simplification helper function that encapsulates the left-to-right and obligatory options.
func CDR[t, l, r, s] {
  return CDRewrite[t, l, r, s, 'ltr', 'obl'];
}

export d1to9 = Optimize[bytelib.kDigit - "0"];
export d02to9 = Optimize[bytelib.kDigit - "1"];
export d2to9 = Optimize[d02to9 - "0"];
export d3to9 = Optimize[d2to9 - "2"];
