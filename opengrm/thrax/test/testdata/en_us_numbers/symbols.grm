# This grammar provides an initial mapping for the generated labels so things
# match up. This grammar should be loaded before the others.

import 'opengrm/thrax/stdlib/byte.grm' as bytelib;

# gthraxlinter: disable=upper-case-exports
export extended_labels = Optimize[
    "[E1]"
  | "[E2]"
  | "[E3]"
  | "[E4]"
  | "[E5]"
  | "[E6]"
  | "[E7]"
  | "[E8]"
  | "[E9]"
  | "[E10]"
  | "[E11]"
  | "[E12]"
  | "[E13]"
  | "[E15]"
  | "[E17]"
  | "[E18]"
  | "[AND]"
  | "[ZERO]"
  | "[tens_marker]"
  | "[decade_marker]"
  | "[thousands_marker]"]
;

# This maps between powers and the byte sequences needed for C++-factorized
# cases in TTS
export SIGMA_STAR = (bytelib.kBytes | extended_labels)*;

extended_labels_to_bytes = Optimize[
     ("[E1]" : "\[E1\]")
   | ("[E2]" : "\[E2\]")
   | ("[E3]" : "\[E3\]")
   | ("[E4]" : "\[E4\]")
   | ("[E5]" : "\[E5\]")
   | ("[E6]" : "\[E6\]")
   | ("[E7]" : "\[E7\]")
   | ("[E8]" : "\[E8\]")
   | ("[E9]" : "\[E9\]")
   | ("[E10]" : "\[E10\]")
   | ("[E11]" : "\[E11\]")
   | ("[E12]" : "\[E12\]")
   | ("[E13]" : "\[E13\]")
   | ("[E15]" : "\[E15\]")
   | ("[E18]" : "\[E18\]")
   | ("[AND]" : "\[AND\]")
   | ("[ZERO]" : "\[ZERO\]")]
;

# And the other way...
bytes_to_extended_labels = Invert[extended_labels_to_bytes];

export EXTENDED_LABELS_TO_BYTES = CDRewrite[
  extended_labels_to_bytes, "", "", SIGMA_STAR];

export BYTES_TO_EXTENDED_LABELS = CDRewrite[
  bytes_to_extended_labels, "", "", SIGMA_STAR];
