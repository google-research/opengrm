# Test grammar for pushdown transducer functionality.

import 'opengrm/thrax/stdlib/byte.grm' as bytelib;
import 'opengrm/thrax/test/testdata/en_us_numbers/number_names.grm' as nn;

digits = (bytelib.kDigit - "0") bytelib.kDigit*;

export PARENS =
    ("[<$>]" : "[</$>]")
  | ("[<£>]" : "[</£>]")
  | ("[<€>]" : "[</€>]")
  | ("[<¥>]" : "[</¥>]")
;

prefix_symbols =
    ("[<$>]" ("$" : ""))
  | ("[<£>]" ("£" : ""))
  | ("[<€>]" ("€" : ""))
  | ("[<¥>]" ("¥" : ""))
;

currency_names =
    (("" : "dollars") "[</$>]")
  | (("" : "pounds") "[</£>]")
  | (("" : "euros") "[</€>]")
  | (("" : "yen") "[</¥>]")
;

currency =
   prefix_symbols
   (digits @ nn.CARDINAL_NUMBER_NAME)
   ("" : " ")
   currency_names
;

sigma_star =
  (  bytelib.kBytes
   | Project[PARENS, 'input']
   | Project[PARENS, 'output'])*
;

singulars =
    ("dollars" : "dollar")
  | ("pounds" : "pound")
  | ("euros" : "euro")
;

singularize = CDRewrite[singulars, "[BOS]one ", "", sigma_star];

export CURRENCY =
   Optimize[PdtCompose[currency, singularize, PARENS, 'left_pdt']]
;
