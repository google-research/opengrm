load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "google_grm_source",
    srcs = glob([
        "*.h",
        "*.cc",
    ]),
    visibility = ["//visibility:private"],
)

cc_library(
    name = "datatype",
    hdrs = ["datatype.h"],
    deps = [
        "@com_google_absl//absl/memory",
        "@com_google_absl//absl/types:variant",
        "@com_google_openfst//openfst/lib",
        "@com_google_openfst//openfst/lib:symbol-table",
    ],
)

cc_library(
    name = "namespace",
    srcs = ["namespace.cc"],
    hdrs = ["namespace.h"],
    deps = [
        ":resource-map",
        "//opengrm/thrax/ast:identifier-node",
        "@com_google_absl//absl/base",
        "@com_google_absl//absl/base:nullability",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/log:check",
        "@com_google_absl//absl/memory",
        "@com_google_absl//absl/strings",
    ],
)

cc_test(
    name = "namespace_test",
    size = "small",
    srcs = ["namespace_test.cc"],
    deps = [
        ":namespace",
        "//opengrm/thrax/ast:identifier-node",
        "@com_google_googletest//:gtest",
        "@com_google_googletest//:gtest_main",
    ],
)

cc_library(
    name = "resource-map",
    hdrs = ["resource-map.h"],
    deps = [
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/log:check",
        "@com_google_absl//absl/memory",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/synchronization",
    ],
)

cc_library(
    name = "register",
    hdrs = ["register.h"],
    deps = [
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/strings",
        "@com_google_openfst//openfst/lib:register",
        "@com_google_openfst//openfst/lib:util",
    ],
)

cc_test(
    name = "resource-map_test",
    srcs = ["resource-map_test.cc"],
    deps = [
        ":resource-map",
        "@com_google_absl//absl/base",
        "@com_google_absl//absl/functional:bind_front",
        "@com_google_googletest//:gtest",
        "@com_google_googletest//:gtest_main",
        "@com_google_openfst//openfst/lib",
    ],
)
