load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "google_grm_source",
    srcs = glob([
        "*.cc",
        "*.h",
    ]),
    visibility = ["//visibility:private"],
)

cc_library(
    name = "base_rule_cascade",
    hdrs = ["base_rule_cascade.h"],
    deps = [
        ":rewrite",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@com_google_openfst//openfst/lib:lib_lite",
        "@com_google_openfst//openfst/lib:string",
        "@com_google_openfst//openfst/lib:symbol-table",
    ],
)

cc_test(
    name = "base_rule_cascade_test",
    srcs = ["base_rule_cascade_test.cc"],
    deps = [
        ":base_rule_cascade",
        "//opengrm/operators:optimize",
        "@com_google_absl//absl/types:span",
        "@com_google_googletest//:gtest_main",
        "@com_google_openfst//openfst/lib",
        "@com_google_openfst//openfst/lib:symbol-table",
    ],
)

cc_library(
    name = "parentheses",
    hdrs = ["parentheses.h"],
    deps = [
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/types:span",
        "@com_google_openfst//openfst/lib",
    ],
)

cc_library(
    name = "rewrite",
    hdrs = ["rewrite.h"],
    deps = [
        "//opengrm/paths",
        "//opengrm/string:stringprint",
        "@com_google_absl//absl/log",
        "@com_google_openfst//openfst/extensions/mpdt:compose",
        "@com_google_openfst//openfst/extensions/pdt:compose",
        "@com_google_openfst//openfst/lib",
        "@com_google_openfst//openfst/lib:symbol-table",
    ],
)

filegroup(
    name = "rewrite_testdata",
    data = [
        ":testdata/rule1.fst",
        ":testdata/rule2.fst",
        ":testdata/rule3.fst",
    ],
)

cc_test(
    name = "rewrite_test",
    size = "medium",
    srcs = ["rewrite_test.cc"],
    data = [":rewrite_testdata"],
    deps = [
        ":rewrite",
        "//opengrm/string:stringcompile",
        "@com_google_absl//absl/log:check",
        "@com_google_googletest//:gtest_main",
        "@com_google_openfst//openfst/compat:file_path",
        "@com_google_openfst//openfst/lib",
    ],
)

cc_library(
    name = "rewrite_manager",
    hdrs = ["rewrite_manager.h"],
    deps = [
        ":parentheses",
        ":rewrite",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/memory",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings",
        "@com_google_openfst//openfst/extensions/far:lib",
        "@com_google_openfst//openfst/lib",
        "@com_google_openfst//openfst/lib:fst-decl",
    ],
)

cc_test(
    name = "rewrite_manager_test",
    srcs = ["rewrite_manager_test.cc"],
    data = ["//opengrm/thrax/test:testdata/cap.sttable.far"],
    deps = [
        ":rewrite_manager",
        "@com_google_absl//absl/base:nullability",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/memory",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/strings:string_view",
        "@com_google_googletest//:gtest_main",
        "@com_google_openfst//openfst/compat:file_path",
        "@com_google_openfst//openfst/compat:status_macros",
        "@com_google_openfst//openfst/extensions/far:lib",
        "@com_google_openfst//openfst/lib",
    ],
)

cc_library(
    name = "rule_cascade",
    hdrs = ["rule_cascade.h"],
    deps = [
        ":base_rule_cascade",
        ":rewrite_manager",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/strings",
        "@com_google_absl//absl/types:span",
        "@com_google_openfst//openfst/lib:lib_lite",
        "@com_google_openfst//openfst/lib:symbol-table",
    ],
)

cc_test(
    name = "rule_cascade_test",
    srcs = ["rule_cascade_test.cc"],
    data = ["//opengrm/thrax:rule_cascade_test_fars"],
    deps = [
        ":rule_cascade",
        "@com_google_absl//absl/status:status_matchers",
        "@com_google_absl//absl/strings:string_view",
        "@com_google_googletest//:gtest_main",
        "@com_google_openfst//openfst/compat:file_path",
        "@com_google_openfst//openfst/lib:string",
    ],
)
