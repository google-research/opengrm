        "@com_google_openfst//openfst/lib",
        "@com_google_openfst//openfst/lib:fst-decl",
    ],
)

# Header that exposes decode and train.
cc_library(
    name = "baumwelch",
    hdrs = ["baumwelch.h"],
    deps = [
        ":decode",
        ":randomize",
        ":train",
    ],
)

# Scoring methods for trained models.
cc_library(
    name = "score",
    hdrs = ["score.h"],
    deps = [
        "//opengrm/string:stringprint",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/log:check",
        "@com_google_openfst//openfst/extensions/far:lib",
        "@com_google_openfst//openfst/lib:fst-decl",
        "@com_google_openfst//openfst/lib:string",
    ],
)

