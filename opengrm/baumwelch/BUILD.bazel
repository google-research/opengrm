)

# 13!-keyspace mono substitution cipher with Baum-Welch training.
cc_test(
    name = "mono-13-log_test",
    timeout = "long",
    srcs = ["mono_test.cc"],
    data = [
        ":testdata/mono/channel-13.fst",
        ":testdata/mono/ciphertext-log.far",
        ":testdata/mono/lm.fst",
        ":testdata/mono/plaintext-log.far",
    ],
    defines = [
        "TEST_13",
        "TEST_LOG",
    ],
    tags = ["notap"],
    deps = [
        ":decipherment-tester",
        ":train",
        "@com_google_absl//absl/flags:flag",
        "@com_google_absl//absl/log:check",
        "@com_google_googletest//:gtest_main",
        "@com_google_openfst//openfst/compat:file_path",
        "@com_google_openfst//openfst/extensions/far:far-reader",
        "@com_google_openfst//openfst/extensions/special:phi-fst",
        "@com_google_openfst//openfst/lib",
    ],
)

