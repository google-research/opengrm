load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

## Libraries.

# Helper for decoding non-path semirings.
cc_library(
    name = "a-star",
    hdrs = ["a-star.h"],
    deps = [
        ":util",
        "@com_google_absl//absl/log",
        "@com_google_openfst//openfst/lib",
        "@com_google_openfst//openfst/lib:fst-decl",
    ],
)

cc_test(
    name = "a-star_test",
    srcs = ["a-star_test.cc"],
    data = [
        ":testdata/a-star/nfa.fst",
        ":testdata/a-star/shortest.fst",
    ],
    deps = [
        ":a-star",
        "@com_google_absl//absl/log:check",
        "@com_google_googletest//:gtest_main",
        "@com_google_openfst//openfst/compat:file_path",
        "@com_google_openfst//openfst/lib",
    ],
)

# Helper for constructing input/channel/output cascades.
cc_library(
    name = "cascade",
    hdrs = ["cascade.h"],
    deps = [
        "@com_google_openfst//openfst/lib",
        "@com_google_openfst//openfst/lib:fst-decl",
    ],
)

cc_test(
    name = "cascade_test",
    srcs = ["cascade_test.cc"],
    deps = [
        ":cascade",
        "@com_google_googletest//:gtest_main",
        "@com_google_openfst//openfst/lib",
    ],
)

# Helper for log-addition.
cc_library(
    name = "log-adder",
    hdrs = ["log-adder.h"],
    deps = ["@com_google_openfst//openfst/lib:weight"],
)

cc_test(
    name = "log-adder_test",
    srcs = ["log-adder_test.cc"],
    deps = [
        ":log-adder",
        "@com_google_googletest//:gtest_main",
        "@com_google_openfst//openfst/lib:weight",
    ],
)

# Helper for expectation tables.
cc_library(
    name = "expectation-table",
    hdrs = ["expectation-table.h"],
    deps = [
        ":log-adder",
        "@com_google_absl//absl/container:flat_hash_map",
        "@com_google_absl//absl/hash",
        "@com_google_openfst//openfst/lib",
    ],
)

cc_test(
    name = "expectation-table_test",
    srcs = ["expectation-table_test.cc"],
    deps = [
        ":expectation-table",
        ":log-adder",
        "@com_google_googletest//:gtest_main",
        "@com_google_openfst//openfst/lib",
    ],
)

# Randomization.
cc_library(
    name = "randomize",
    hdrs = ["randomize.h"],
    deps = [
        "@com_google_absl//absl/random",
        "@com_google_absl//absl/random:bit_gen_ref",
        "@com_google_absl//absl/random:distributions",
        "@com_google_openfst//openfst/lib",
    ],
)

# Helpers.
cc_library(
    name = "util",
    hdrs = ["util.h"],
)

cc_library(
    name = "train",
    hdrs = ["train.h"],
    deps = [
        ":cascade",
        ":expectation-table",
        ":log-adder",
        ":util",
        "@com_google_absl//absl/log",
        "@com_google_openfst//openfst/extensions/far:lib",
        "@com_google_openfst//openfst/lib",
    ],
)

# Decoding methods for trained models.
cc_library(
    name = "decode",
    hdrs = ["decode.h"],
    deps = [
        ":a-star",
        ":cascade",
        "@com_google_absl//absl/strings",
