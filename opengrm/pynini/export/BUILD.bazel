"""Pynini Exporter Libraries"""

load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load(":grm_py_build_defs.bzl", "compile_grm_py", "compile_multi_grm_py")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "grm",
    srcs = ["grm.py"],
    deps = [
        ":export",
        "@com_google_absl_py//absl:app",
        "@com_google_absl_py//absl/flags",
    ],
)

py_test(
    name = "grm_test",
    srcs = ["grm_test.py"],
    deps = [
        ":grm",
        "//opengrm/pynini",
        "@com_google_absl_py//absl/flags",
        "@com_google_absl_py//absl/testing:absltest",
        "@com_google_absl_py//absl/testing:flagsaver",
    ],
)

compile_grm_py(
    name = "grm_example",
    deps = ["//opengrm/pynini"],
)

build_test(
    name = "grm_example_test",
    targets = [":grm_example"],
)

py_library(
    name = "multi_grm",
    srcs = ["multi_grm.py"],
    deps = [
        ":export",
        "@com_google_absl_py//absl:app",
        "@com_google_absl_py//absl/flags",
        "@com_google_absl_py//absl/logging",
    ],
)

py_test(
    name = "multi_grm_test",
    srcs = ["multi_grm_test.py"],
    deps = [
        ":multi_grm",
        "//opengrm/pynini",
        "@com_google_absl_py//absl/flags",
        "@com_google_absl_py//absl/testing:absltest",
        "@com_google_absl_py//absl/testing:flagsaver",
    ],
)

compile_multi_grm_py(
    name = "multi_grm_example",
    outs = {
        "a": "a.far",
        "b": "b.far",
    },
    deps = ["//opengrm/pynini"],
)

build_test(
    name = "multi_grm_example_test",
    targets = [":multi_grm_example"],
)

py_library(
    name = "export",
    srcs = ["export.py"],
    deps = [
        "//opengrm/pynini",
        "@com_google_absl_py//absl/logging",
    ],
)

py_test(
    name = "export_test",
    srcs = ["export_test.py"],
    deps = [
        ":export",
        "//opengrm/pynini",
        "@com_google_absl_py//absl/flags",
        "@com_google_absl_py//absl/testing:absltest",
    ],
)

bzl_library(
    name = "grm_py_build_defs_bzl",
    srcs = ["grm_py_build_defs.bzl"],
    deps = ["@com_google_openfst//openfst/extensions/far:build_defs_bzl"],
)
