load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "byte",
    srcs = ["byte.py"],
    deps = ["//opengrm/pynini"],
)

py_test(
    name = "byte_test",
    size = "small",
    srcs = ["byte_test.py"],
    deps = [
        ":byte",
        "//opengrm/pynini",
        "@com_google_absl_py//absl/testing:absltest",
    ],
)

