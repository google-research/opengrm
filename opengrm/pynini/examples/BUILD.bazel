load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "case",
    srcs = ["case.py"],
    deps = [
        "//opengrm/pynini",
        "//opengrm/pynini/lib:rewrite",
    ],
)

py_test(
    name = "case_test",
    size = "small",
    srcs = ["case_test.py"],
    deps = [
        ":case",
        "@com_google_absl_py//absl/testing:absltest",
    ],
)

py_library(
    name = "chatspeak",
    srcs = ["chatspeak.py"],
    deps = [
        "//opengrm/pynini",
        "//opengrm/pynini/lib:byte",
        "//opengrm/pynini/lib:pynutil",
        "//opengrm/pynini/lib:rewrite",
    ],
)

py_test(
    name = "chatspeak_test",
    size = "small",
    srcs = ["chatspeak_test.py"],
    data = ["//opengrm/pynini/examples/testdata:chatspeak_lexicon.tsv"],
    deps = [
        ":chatspeak",
        "//opengrm/pynini",
        "//opengrm/pynini:runfiles",
        "//opengrm/pynini/lib:rewrite",
        "@com_google_absl_py//absl/testing:absltest",
    ],
)

