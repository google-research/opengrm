load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load(
    "//devtools/python/blaze:pytype.bzl",
    "pytype_strict_contrib_test",
)  # @unused, but may be used later.

package(
    default_visibility = ["//visibility:public"],
    features = [
        "layering_check",
        "-use_header_modules",
    ],
)

py_binary(
    name = "compile_verbs",
    srcs = ["compile_verbs.py"],
    deps = [
        "//opengrm/pynini",
        "//opengrm/pynini/export",
        "//opengrm/pynini/lib:byte",
        "//opengrm/pynini/lib:features",
        "//opengrm/pynini/lib:paradigms",
        "@com_google_absl_py//absl:app",
        "@com_google_absl_py//absl/flags",
    ],
)

genrule(
    name = "latin_verbs_far",
    srcs = [
        "first_conjugation.txt",
        "first_verb_stems.txt",
        "second_conjugation.txt",
        "second_verb_stems.txt",
        "third_conjugation.txt",
        "third_verb_stems.txt",
    ],
    outs = ["latin_verbs.far"],
    cmd = "$(location //opengrm/pynini/examples/latin:compile_verbs) --far=$@",
    tools = [
        ":compile_verbs",
    ],
)

#pytype_strict_contrib_test(
py_test(
    name = "verbs_test",
    srcs = ["verbs_test.py"],
    data = [
        ":latin_verbs_far",
    ],
    deps = [
        "//opengrm/pynini",
        "@com_google_absl_py//absl:app",
        "@com_google_absl_py//absl/flags",
        "@com_google_absl_py//absl/testing:absltest",
    ],
)
