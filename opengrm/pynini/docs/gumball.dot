digraph FST {
rankdir = LR;
label = "";
center = 1;
orientation = Portrait;
ranksep = "0.4";
nodesep = "0.25";
node [fontname = "sans"];
edge [fontname = "sans"];
0 [label = "0", shape = doublecircle, style = bold, fontsize = 14]
	0 -> 0 [label = "Knob : ε", fontsize = 14];
	0 -> 1 [label = "Coin : ε", fontsize = 14];
1 [label = "1", shape = circle, style = solid, fontsize = 14]
	1 -> 0 [label = "Knob : Gumball", fontsize = 14];
}
