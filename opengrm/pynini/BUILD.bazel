load("@com_google_openfst//:bazel/cython_build_defs.bzl", "pyx_library")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

package(default_visibility = ["//visibility:public"])

# To add Pynini support to your Python application or library, add the
# following target as a dependency, and then import it like so:
#
# from opengrm.pynini import pynini
pyx_library(
    name = "pynini",
    srcs = [
        "cpynini.pxd",
        "pynini.pyx",
    ],
    cc_deps = [
        "//opengrm/operators:cdrewrite",
        "//opengrm/operators:cdrewritescript",
        "//opengrm/operators:concatrangescript",
        "//opengrm/operators:crossscript",
        "//opengrm/operators:getters",
        "//opengrm/operators:lenientlycomposescript",
        "//opengrm/operators:optimizescript",
        "//opengrm/paths:script",
        "//opengrm/string:defaults",
        "//opengrm/string:stringcompile",
        "//opengrm/string:stringcompilescript",
        "//opengrm/string:stringmapscript",
        "//opengrm/string:stringprintscript",
        "//opengrm/string:stringutil",
        "@com_google_openfst//openfst/extensions/mpdt:compose",
        "@com_google_openfst//openfst/extensions/mpdt:expand",
        "@com_google_openfst//openfst/extensions/mpdt:read_write_utils",
        "@com_google_openfst//openfst/extensions/mpdt:script",
        "@com_google_openfst//openfst/extensions/pdt:compose",
        "@com_google_openfst//openfst/extensions/pdt:replace",
        "@com_google_openfst//openfst/extensions/pdt:script",
    ],
    # Canonical Bzlmod external repository path.
    cython_includes = ["external/openfst+"],
    # Routes distinct Python packages to a single canonical vtable anchor.
    dynamic_deps = [
        "@com_google_openfst//openfst/extensions/python:pywrapfst_main_cc_shared",
    ],
    pxd_deps = [
        "@com_google_openfst//openfst/extensions/python:pywrapfst_pxds",
    ],
    py_deps = ["@com_google_openfst//openfst:pywrapfst"],
    pyi_deps = ["@com_google_openfst//openfst:pywrapfst"],
    pyi_srcs = ["pynini.pyi"],
)

# Python-based unit tests.
py_test(
    name = "pynini_test",
    size = "small",
    srcs = ["pynini_test.py"],
    data = [":testdata"],
    deps = [
        ":pynini",
        ":runfiles",
        "@com_google_absl_py//absl/testing:absltest",
        "@com_google_absl_py//absl/testing:parameterized",
        "@com_google_openfst//openfst:pywrapfst",
    ],
)

