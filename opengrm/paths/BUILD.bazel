load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "google_grm_source",
    srcs = glob([
        "*.h",
        "*.cc",
    ]),
    visibility = ["//visibility:private"],
)

cc_library(
    name = "paths",
    hdrs = ["paths.h"],
    deps = [
        "@com_google_openfst//openfst/lib:lib_lite",
        "@com_google_openfst//openfst/lib:util",
    ],
)

filegroup(
    name = "testdata",
    data = glob(["testdata/**"]),
)

cc_library(
    name = "script",
    srcs = ["pathsscript.cc"],
    hdrs = ["pathsscript.h"],
    deps = [
        ":paths",
        "@com_google_openfst//openfst/lib:lib_lite",
        "@com_google_openfst//openfst/lib:string",
        "@com_google_openfst//openfst/lib:symbol-table",
        "@com_google_openfst//openfst/script",
        "@com_google_openfst//openfst/script:fstscript",
    ],
)

cc_test(
    name = "paths_test",
    size = "small",
    srcs = ["paths_test.cc"],
    data = [":testdata"],
    deps = [
        ":paths",
        ":script",
        "@com_google_absl//absl/strings",
        "@com_google_googletest//:gtest_main",
        "@com_google_openfst//openfst/compat:file_path",
        "@com_google_openfst//openfst/lib",
        "@com_google_openfst//openfst/lib:symbol-table",
        "@com_google_openfst//openfst/script",
    ],
)
